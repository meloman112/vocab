# Шаблон конфигурации. Копируется в .env, .env в git не попадает никогда.
# Пустое значение здесь означает «заполнить обязательно»: умолчаний
# для секретов не бывает.

# Домен сервиса в NetBird Reverse Proxy. TLS и публичное имя даёт он,
# поэтому своего Caddy и ACME здесь нет.
DOMAIN=vocab.proxy.blick.uz

# NetBird-адрес этой машины: `netbird status -d | grep "NetBird IP"`.
# На нём слушает api, до него ходит reverse proxy. Пусто — API доступен
# только с самого хоста.
BIND_ADDR=

POSTGRES_DB=vocab
POSTGRES_USER=vocab
POSTGRES_PASSWORD=

# @BotFather
BOT_TOKEN=
# Свой telegram id (@userinfobot). Бот пускает только его.
OWNER_TG_ID=

# Токен для букмарклета, расширения и MCP. Любая длинная случайная строка:
#   openssl rand -hex 32
API_TOKEN=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Часовой пояс владельца: от него зависят «сегодня» в статистике
# и время напоминаний.
TZ=Asia/Tashkent
REMINDER_HOURS=9,20

LOG_LEVEL=INFO
