# Шаблон конфигурации. Копируется в .env, .env в git не попадает никогда.
# Пустое значение здесь означает «заполнить обязательно»: умолчаний
# для секретов не бывает.

# Домен, на котором висит Caddy. Telegram открывает мини-апп только по HTTPS,
# так что домен обязан быть настоящим и резолвиться.
DOMAIN=
ACME_EMAIL=

POSTGRES_DB=vocab
POSTGRES_USER=vocab
POSTGRES_PASSWORD=

# @BotFather
BOT_TOKEN=
# Свой telegram id (@userinfobot). Бот пускает только его.
OWNER_TG_ID=

# Токен для букмарклета, расширения и MCP. Любая длинная случайная строка:
#   openssl rand -hex 32
API_TOKEN=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Часовой пояс владельца: от него зависят «сегодня» в статистике
# и время напоминаний.
TZ=Asia/Tashkent
REMINDER_HOURS=9,20

LOG_LEVEL=INFO
