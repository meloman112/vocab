{
  "manifest_version": 3,
  "name": "vocab",
  "version": "1.0.1",
  "description": "Добавить выделенное слово в личный словарь",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "bg.js",
    "scripts": ["bg.js"]
  },
  "options_ui": {
    "page": "options.html"
  },
  "icons": { "16": "icon.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "vocab@blick.uz",
      "strict_min_version": "128.0"
    }
  }
}
